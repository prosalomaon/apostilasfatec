---
layout: base
---

<div class="subject-header">
  <h1>{{ subject_title }}</h1>
  <p class="subject-intro">{{ subject_description }}</p>
</div>

{% for bimester in bimesters %}
{% set period_label = (bimester_labels | default({}))[bimester.tag] or bimester.label %}
{% set unit = unit_label | default("AULA") %}
<section class="bimester-section">
  <h2 class="bimester-title">
    {{ period_label }}{% if bimester_titles[bimester.tag] %}: {{ bimester_titles[bimester.tag] }}{% endif %}
  </h2>
  <div class="lesson-grid">
    {% set lessons = collections.aulas | filterBySubjectBimester(subject, bimester.tag) %}
    {% for post in lessons %}
    <a href="{{ post.url | url }}" class="lesson-card">
      <span class="number">{{ unit | upper }} {{ post.data.aula_numero }}</span>
      <span class="title">{{ post.data.title }}</span>
      <span class="lesson-desc">{{ post.data.description }}</span>
    </a>
    {% else %}
    <p class="empty-state">Nenhum conteúdo cadastrado para este período.</p>
    {% endfor %}
  </div>
</section>
{% endfor %}

